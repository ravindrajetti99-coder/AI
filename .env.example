# Copy to .env and edit. Read by docker compose and by the API (which also reads apps/api/.env).
# Every API setting is EDU_<NAME>; the full list is apps/api/app/core/config.py.

# Runtime: development | test | production
EDU_ENV=development
# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EDU_SECRET_KEY=dev-only-change-me-please-32-bytes-min
# Set to true when the site is served over HTTPS.
EDU_COOKIE_SECURE=false

# Database and cache. docker compose sets EDU_DATABASE_URL and EDU_REDIS_URL itself;
# set them here only when running the API directly (SQLite is the default).
POSTGRES_PASSWORD=eduverse
# EDU_DATABASE_URL=postgresql+psycopg://eduverse:eduverse@localhost:5432/eduverse
# EDU_REDIS_URL=redis://localhost:6379/0

# First admin account, created by `python -m app.seed` (and by SEED_ON_START in Docker).
EDU_ADMIN_EMAIL=admin@example.com
EDU_ADMIN_PASSWORD=change-me-to-a-long-password
SEED_ON_START=true

# AI providers. Without keys every AI feature runs on the built-in offline engines.
# Prefer a secrets file over this .env: put the key in /run/secrets/EDU_ANTHROPIC_API_KEY
# (Docker/Compose secrets, or EDU_SECRETS_DIR) or your platform's secret store. A variable that
# is set, even to an empty value, wins over the file, so leave these commented out then.
# EDU_ANTHROPIC_API_KEY=
# EDU_ANTHROPIC_API_KEY_SECONDARY=   # rotation: used when the primary key is rejected
# EDU_OPENAI_API_KEY=
EDU_AI_PRIMARY=anthropic
EDU_AI_FALLBACK=openai
# EDU_ANTHROPIC_MODEL_HEAVY=claude-opus-5-5
# EDU_ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5
# EDU_ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
# Thinking depth per tier (low | medium | high | xhigh | max; empty = the model's default).
# EDU_ANTHROPIC_EFFORT_HEAVY=medium
# EDU_ANTHROPIC_EFFORT_STANDARD=medium
# EDU_ANTHROPIC_EFFORT_LIGHT=low
# EDU_AI_PROMPT_CACHING=true
# EDU_AI_STRUCTURED_OUTPUTS=true
# Per task: tier, effort, max_tokens, prompt_cache. Example:
# EDU_AI_TASK_OVERRIDES={"examiner.evaluate": {"effort": "high"}, "tutor.chat": {"tier": "light"}}
# Limits: tokens per user per 24 h, and an organisation-wide spend cap in USD per 24 h
# (0 = none; at the cap everything answers offline; admins get an email at 80%).
EDU_AI_DAILY_TOKEN_BUDGET_LEARNER=200000
# EDU_AI_DAILY_SPEND_CAP_USD=20
# EDU_AI_MAX_INPUT_TOKENS=30000
# Check keys and models after deploying or rotating: python -m app.ai.check (add --live for a real call)

# Email: console (development: logs emails), ses (Amazon SES) or smtp. Production refuses console.
EDU_MAIL_BACKEND=console
EDU_MAIL_FROM=EduVerse AI <no-reply@eduverse.local>
# EDU_MAIL_REPLY_TO=support@your-domain
# Amazon SES: the From address must be a verified identity (domain with DKIM) in this region.
# Credentials come from the standard AWS chain: these variables, or the task/instance role.
# EDU_SES_REGION=ap-south-1
# EDU_SES_CONFIGURATION_SET=eduverse-events
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# SMTP instead: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465
# EDU_SMTP_URL=
# Links in emails point here (reset, verification, invites). Must be https:// in production.
EDU_PUBLIC_WEB_URL=http://localhost:3000

# Registration: open, or invite (an admin creates invite codes in the content studio).
EDU_REGISTRATION_MODE=open

# Background jobs. The API enqueues; `python -m app.worker` runs them. With the embedded worker
# the API process runs jobs itself (development, demos, one small instance); docker compose runs
# a separate worker service and turns it off.
# EDU_JOBS_EMBEDDED_WORKER=true
# EDU_JOBS_STALE_AFTER_SECONDS=300
# EDU_JOBS_RETENTION_DAYS=30
# At most this many jobs per queue run at once across all workers (keeps AI generation within
# provider rate limits): EDU_JOBS_QUEUE_CONCURRENCY={"content": 2}

# Code runner: local (development only), judge0 (production) or disabled.
EDU_CODE_RUNNER=local
# EDU_JUDGE0_URL=http://judge0:2358
